# Compile the pinned image-processing subset without upstream tests or wrappers.
set(SIMD_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/simd")
if(NOT EXISTS "${SIMD_SOURCE_DIR}/src/Simd/SimdResizer.h")
    message(FATAL_ERROR "Initialise the Simd submodule with git submodule update --init --recursive")
endif()
set(simd_definitions SIMD_SYNET_DISABLE SIMD_AVX512BW_DISABLE SIMD_AVX512VNNI_DISABLE SIMD_AMXBF16_DISABLE SIMD_SVE2_DISABLE)
set(simd_sources)
set(simd_variants Base)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|amd64|x86_64|x86|i.86" AND NOT CMAKE_GENERATOR_PLATFORM MATCHES "ARM")
    list(APPEND simd_variants Sse41 Avx2)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
    list(APPEND simd_variants Neon)
    list(APPEND simd_definitions SIMD_SSE41_DISABLE SIMD_AVX2_DISABLE)
else()
    list(APPEND simd_definitions SIMD_SSE41_DISABLE SIMD_AVX2_DISABLE SIMD_NEON_DISABLE)
endif()
foreach(variant IN LISTS simd_variants)
    file(GLOB variant_sources CONFIGURE_DEPENDS
        "${SIMD_SOURCE_DIR}/src/Simd/Simd${variant}Resizer*.cpp"
        "${SIMD_SOURCE_DIR}/src/Simd/Simd${variant}AlphaBlending.cpp"
        "${SIMD_SOURCE_DIR}/src/Simd/Simd${variant}Cpu.cpp")
    if(variant STREQUAL "Avx2")
        if(MSVC)
            set_source_files_properties(${variant_sources} PROPERTIES COMPILE_OPTIONS "/arch:AVX2")
        else()
            set_source_files_properties(${variant_sources} PROPERTIES COMPILE_OPTIONS "-mavx2;-mfma;-mf16c;-mbmi;-mbmi2;-mlzcnt")
        endif()
    elseif(variant STREQUAL "Sse41" AND NOT MSVC)
        set_source_files_properties(${variant_sources} PROPERTIES COMPILE_OPTIONS "-msse4.2")
    endif()
    list(APPEND simd_sources ${variant_sources})
endforeach()
add_library(g0v0_simd STATIC ${simd_sources} "${SIMD_SOURCE_DIR}/src/Simd/SimdBaseThread.cpp")
set_target_properties(g0v0_simd PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(g0v0_simd PUBLIC "${SIMD_SOURCE_DIR}/src")
target_compile_definitions(g0v0_simd PUBLIC ${simd_definitions})
if(MSVC AND (CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64"))
    target_compile_options(g0v0_simd PRIVATE "/FI${CMAKE_CURRENT_SOURCE_DIR}/msvc-arm64-cpuid.h")
endif()
target_link_libraries(g0v0-image-codecs PRIVATE g0v0_simd)
target_sources(g0v0-image-codecs PRIVATE image_processing.cpp)
install(FILES "${SIMD_SOURCE_DIR}/LICENSE" DESTINATION licences RENAME LICENCE-Simd)
