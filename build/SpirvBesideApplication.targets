<Project>
  <!-- With Veldrid.SPIRV as a project reference, its native libraries for every platform are copied as content under runtimes/<rid>/native/
       and are absent from deps.json, where the loader cannot find them. Drop foreign platforms' SPIRV natives from build/publish outputs
       and place only the target platform's library beside the application, as the NuGet package's runtime assets would. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <_G0V0SpirvArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_G0V0SpirvArchitecture>
    <!-- The package ships a single universal macOS library under runtimes/osx/. -->
    <_G0V0SpirvRuntime Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">osx</_G0V0SpirvRuntime>
    <_G0V0SpirvRuntime Condition="'$(_G0V0SpirvRuntime)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_G0V0SpirvRuntime>
    <_G0V0SpirvRuntime Condition="'$(_G0V0SpirvRuntime)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$(_G0V0SpirvArchitecture)</_G0V0SpirvRuntime>
    <_G0V0SpirvRuntime Condition="'$(_G0V0SpirvRuntime)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(_G0V0SpirvArchitecture)</_G0V0SpirvRuntime>
    <_G0V0SpirvRuntime Condition="'$(_G0V0SpirvRuntime)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx</_G0V0SpirvRuntime>
    <_G0V0SpirvTargetPrefix>runtimes/$(_G0V0SpirvRuntime)/native/</_G0V0SpirvTargetPrefix>
  </PropertyGroup>

  <Target Name="G0V0FilterSpirvOutputItems" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopySourceItemsToOutputDirectory" Condition="'$(_G0V0SpirvRuntime)' != ''">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)"
                                           Condition="$([System.String]::Copy('%(TargetPath)').Replace('\', '/').StartsWith('runtimes/')) and $([System.String]::Copy('%(TargetPath)').Contains('veldrid-spirv')) and !$([System.String]::Copy('%(TargetPath)').Replace('\', '/').StartsWith('$(_G0V0SpirvTargetPrefix)'))" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)"
                                                 Condition="$([System.String]::Copy('%(TargetPath)').Replace('\', '/').StartsWith('runtimes/')) and $([System.String]::Copy('%(TargetPath)').Contains('veldrid-spirv')) and !$([System.String]::Copy('%(TargetPath)').Replace('\', '/').StartsWith('$(_G0V0SpirvTargetPrefix)'))" />
    </ItemGroup>
  </Target>

  <Target Name="G0V0CopySpirvBesideApplication" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(_G0V0SpirvRuntime)' != ''">
    <ItemGroup>
      <_G0V0SpirvLibrary Include="$(OutDir)runtimes/$(_G0V0SpirvRuntime)/native/*veldrid-spirv.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_G0V0SpirvLibrary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="G0V0FilterSpirvPublishItems" AfterTargets="ComputeFilesToPublish" BeforeTargets="CopyFilesToPublishDirectory" Condition="'$(_G0V0SpirvRuntime)' != ''">
    <ItemGroup>
      <_G0V0MatchingSpirvPublish Include="@(ResolvedFileToPublish)"
                                 Condition="$([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('$(_G0V0SpirvTargetPrefix)')) and $([System.String]::Copy('%(Filename)').Contains('veldrid-spirv'))" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('runtimes/')) and $([System.String]::Copy('%(RelativePath)').Contains('veldrid-spirv'))" />
      <ResolvedFileToPublish Include="@(_G0V0MatchingSpirvPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
