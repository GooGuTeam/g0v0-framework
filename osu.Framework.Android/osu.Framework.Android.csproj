<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>g0v0!framework Android</AssemblyTitle>
    <AssemblyName>osu.Framework.Android</AssemblyName>
    <RootNamespace>osu.Framework.Android</RootNamespace>
    <Description>A 2D application/game framework written with rhythm games in mind.</Description>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>g0v0!framework Android</Title>
    <PackageId>g0v0.Framework.Android</PackageId>
    <PackageTags>g0v0 osu game framework</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Framework\osu.Framework.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The managed HarfBuzzSharp package only carries desktop natives; the Android library is a separate package
         and has to be referenced from a project that targets Android, not from the framework itself. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Version="14.4.0.200" />
    <PackageReference Include="Xamarin.AndroidX.Window" Version="1.2.0.1" PrivateAssets="compile" />
  </ItemGroup>
</Project>
